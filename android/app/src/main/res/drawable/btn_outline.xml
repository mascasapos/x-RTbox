<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#44B026FF" />
            <stroke android:width="1.5dp" android:color="#FFE2B3FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#14B026FF" />
            <stroke android:width="1.5dp" android:color="#FFB026FF" />
        </shape>
    </item>
</selector>
