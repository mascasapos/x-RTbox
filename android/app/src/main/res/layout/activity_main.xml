<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.xrtbox.app.RadiationView
                android:id="@+id/logo"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal" />

            <ImageButton
                android:id="@+id/btnScope"
                android:layout_width="62dp"
                android:layout_height="50dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginRight="22dp"
                android:background="@drawable/btn_outline"
                android:contentDescription="@string/scope_open"
                android:src="@drawable/ic_scope"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/busyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:textColor="@color/neon_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.35"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
